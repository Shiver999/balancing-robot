# Supplemental opt-in sensor acquisition plus read-only BLE status service.
CONFIG_ROBOT_SENSOR_BENCH=y
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_ROBOT_BLE_TELEMETRY=y

# Confirmed MPU-6500 uses I2C; encoders retain SPI.
CONFIG_ROBOT_IMU_USE_I2C=y
CONFIG_ROBOT_IMU_I2C_SDA=17
CONFIG_ROBOT_IMU_I2C_SCL=4
CONFIG_ROBOT_IMU_I2C_ADDRESS=104

# Onboard NeoPixel: original DevKitC-1 uses GPIO48; v1.1 selects GPIO38 in menuconfig.
CONFIG_ROBOT_BLE_STATUS_LED=y
CONFIG_ROBOT_STATUS_LED_GPIO48=y
